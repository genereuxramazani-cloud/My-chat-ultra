                        ];
                      }

                      return [
                        SliverAppBar(
                          pinned: true,
                          floating: false,
                          snap: false,
                          backgroundColor: Colors.transparent,
                          elevation: 0,
                          flexibleSpace: Container(
                            decoration: const BoxDecoration(
                              gradient: LinearGradient(colors: [
                                Color(0xFF050510),
                                Color(0xFF0D0D2B)
