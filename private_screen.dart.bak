  void _showIncomingCallDialog(String callId, String callerId, bool isVideo) {
    showDialog(
      context: context,
      barrierDismissible: false,
      builder: (ctx) => AlertDialog(
        backgroundColor: kSurface,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(24)),
        title: Row(children: [
          Icon(isVideo ? Icons.videocam : Icons.call,
              color: isVideo ? kViolet : kCyan),
          const SizedBox(width: 10),
          Expanded(
            child: Text(
              isVideo ? 'Appel vidéo entrant' : 'Appel vocal entrant',
              style: const TextStyle(color: kText, fontSize: 16),
            ),
          ),
        ]),
        content: Column(mainAxisSize: MainAxisSize.min, children: [
          _buildInitialsAvatar(callerId, 64),
          const SizedBox(height: 12),
          Text(callerId,
              style: const TextStyle(
                  color: kCyan, fontSize: 18, fontWeight: FontWeight.bold)),
          const SizedBox(height: 4),
          const Text('vous appelle...', style: TextStyle(color: kTextDim)),
        ]),
        actions: [
          TextButton.icon(
            onPressed: () async {
              Navigator.of(ctx).pop();
              await _callAlertService.stopRingtone();
              await FirebaseFirestore.instance
                  .collection('calls')
                  .doc(callId)
                  .update({'status': 'declined'});
            },
            icon: const Icon(Icons.call_end, color: kPink),
            label: const Text('Refuser', style: TextStyle(color: kPink)),
          ),
          ElevatedButton.icon(
            style: ElevatedButton.styleFrom(
              backgroundColor: kCyan.withOpacity(0.15),
              shape: RoundedRectangleBorder(
                  borderRadius: BorderRadius.circular(12)),
            ),
            onPressed: () async {
              Navigator.of(ctx).pop();
              await _callAlertService.stopRingtone();
              await _webrtcService.initRenderers();
              final success =
                  await _webrtcService.joinCall(callId, video: isVideo);
              if (success && mounted) {
                setState(() {
                  _inCall = true;
                  _isVideoCall = isVideo;
                  _selectedContact = callerId;
                  _selectedContactData = {
                    'contact': callerId,
                    'name': callerId
                  };
                });
              }
            },
            icon: Icon(isVideo ? Icons.videocam : Icons.call, color: kCyan),
            label: Text('Répondre', style: TextStyle(color: kCyan)),
          ),
        ],
      ),
    );
  }

  Widget _buildCallScreen() {
    final contactName = _selectedContactData?['name'] ?? _selectedContact!;

    return Container(
      color: Colors.black,
      child: Stack(children: [
        if (_isVideoCall)
          RTCVideoView(_webrtcService.remoteRenderer)
        else
          Center(
            child:
                Column(mainAxisAlignment: MainAxisAlignment.center, children: [
              _buildContactAvatar(_selectedContactData ?? {}, size: 100),
              const SizedBox(height: 20),
              Text(contactName,
                  style: const TextStyle(
                      color: Colors.white,
                      fontSize: 22,
                      fontWeight: FontWeight.bold)),
              const SizedBox(height: 8),
              Text(
                _callAnswered ? 'En communication' : 'Appel en cours...',
                style: const TextStyle(color: kTextDim, fontSize: 14),
              ),
              if (_callAnswered)
                Padding(
                  padding: const EdgeInsets.only(top: 6),
                  child: Text(
                    _callDuration,
                    style: const TextStyle(color: Colors.white70, fontSize: 13),
                  ),
                ),
            ]),
          ),
        if (_isVideoCall && !_camOff)
          Positioned(
            top: 60,
            right: 16,
            child: SizedBox(
              width: 100,
              height: 150,
              child: RTCVideoView(_webrtcService.localRenderer),
            ),
          ),
        Positioned(
          bottom: 60,
          left: 0,
          right: 0,
          child:
              Row(mainAxisAlignment: MainAxisAlignment.spaceEvenly, children: [
            _callButton(
                icon: _micMuted ? Icons.mic_off : Icons.mic,
                color: _micMuted ? kPink : kCyan,
                onTap: _toggleMic),
            _callButton(
                icon: Icons.call_end, color: kPink, size: 60, onTap: _endCall),
            if (_isVideoCall)
              _callButton(
                  icon: _camOff ? Icons.videocam_off : Icons.videocam,
                  color: _camOff ? kPink : kViolet,
                  onTap: _toggleCam)
            else
              _callButton(
                  icon: _speakerOn ? Icons.volume_up : Icons.volume_off,
                  color: _speakerOn ? kCyan : kViolet,
                  onTap: _toggleSpeaker),
          ]),
        ),
      ]),
    );
  }

  Widget _callButton(
      {required IconData icon,
      required Color color,
      required VoidCallback onTap,
      double size = 50}) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        width: size,
        height: size,
        decoration: BoxDecoration(
          shape: BoxShape.circle,
          color: color.withOpacity(0.2),
          border: Border.all(color: color, width: 2),
        ),
        child: Icon(icon, color: color, size: size * 0.45),
      ),
    );
  }

  Widget _buildContactList() {
    return StreamBuilder<QuerySnapshot>(
      stream: FirebaseFirestore.instance
          .collection('private_threads')
          .where('members', arrayContains: widget.userPhone)
          .snapshots(),
      builder: (context, threadSnapshot) {
        if (threadSnapshot.hasError) {
          return const Center(
              child: Text('Erreur', style: TextStyle(color: kPink)));
        }

        if (!threadSnapshot.hasData) {
          return const Center(child: CircularProgressIndicator(color: kViolet));
        }

        return StreamBuilder<QuerySnapshot>(
          stream: FirebaseFirestore.instance
              .collection('contacts')
              .where('owner', isEqualTo: widget.userPhone)
              .snapshots(),
          builder: (context, contactSnapshot) {
            if (contactSnapshot.hasError) {
              return const Center(
                  child: Text('Erreur', style: TextStyle(color: kPink)));
            }

            if (!contactSnapshot.hasData) {
              return const Center(
                  child: CircularProgressIndicator(color: kViolet));
            }

            final contactDocs = contactSnapshot.data!.docs;

            final threadDocs = threadSnapshot.data!.docs;

            final contactMap = <String, Map<String, dynamic>>{};

            for (final doc in contactDocs) {
              final data = doc.data() as Map<String, dynamic>;

              final phone = data['contact'] as String?;

              if (phone != null && phone.isNotEmpty) {
                contactMap[phone] = data;
              }
            }

            final threadCards = threadDocs
                .map((doc) {
                  final data = doc.data() as Map<String, dynamic>;

                  final peer = _resolveThreadPeer(data);

                  final archivedByUsers =
                      List<String>.from(data['archivedByUsers'] ?? const []);

                  final deletedByUsers =
                      List<String>.from(data['deletedByUsers'] ?? const []);

                  if (archivedByUsers.contains(widget.userPhone) ||
                      deletedByUsers.contains(widget.userPhone)) {
                    return null;
                  }

                  final contactData = contactMap[peer];

                  final displayName =
                      contactData?['name'] as String? ?? 'Num inconnu';

                  final lastMessage = data['lastMessage'] as String? ?? '';

                  final updatedAt = data['updatedAt'];

                  DateTime? updatedTime;

                  if (updatedAt is Timestamp) {
                    updatedTime = updatedAt.toDate();
                  }

                  return {
                    'docId': doc.id,
                    'peer': peer,
                    'displayName': displayName,
                    'lastMessage': lastMessage,
                    'updatedAt': updatedTime,
                    'contactData': contactData,
                  };
                })
                .whereType<Map<String, dynamic>>()
                .where((item) => (item['peer'] as String).isNotEmpty)
                .toList();

            threadCards.sort((a, b) {
              final aTime = (a['updatedAt'] as DateTime?) ??
                  DateTime.fromMillisecondsSinceEpoch(0);

              final bTime = (b['updatedAt'] as DateTime?) ??
                  DateTime.fromMillisecondsSinceEpoch(0);

              return bTime.compareTo(aTime);
            });

            final savedContacts = contactDocs.where((doc) {
              final data = doc.data() as Map<String, dynamic>;

              final phone = data['contact'] as String?;

              return phone != null &&
                  phone.isNotEmpty &&
                  !threadCards.any((item) => item['peer'] == phone);
            }).toList();

            final query = _contactsSearch.trim().toLowerCase();

            final activeAccountName =
                globalProfileService.name ?? widget.userPhone;

            final filteredThreads = threadCards.where((item) {
              if (query.isEmpty) return true;

              final peer = (item['peer'] as String).toLowerCase();

              final displayName = (item['displayName'] as String).toLowerCase();

              final lastMessage = (item['lastMessage'] as String).toLowerCase();

              return peer.contains(query) ||
                  displayName.contains(query) ||
                  lastMessage.contains(query);
            }).toList();

            final filteredContacts = savedContacts.where((doc) {
              if (query.isEmpty) return true;

              final data = doc.data() as Map<String, dynamic>;

              final contact = (data['contact'] as String? ?? '').toLowerCase();

              final name = (data['name'] as String? ?? contact).toLowerCase();

              final email = (data['email'] as String? ?? '').toLowerCase();

              return contact.contains(query) ||
                  name.contains(query) ||
                  email.contains(query);
            }).toList();

            if (filteredThreads.isEmpty && filteredContacts.isEmpty) {
              return Center(
                child: Column(
                    mainAxisAlignment: MainAxisAlignment.center,
                    children: [
                      Icon(
                          query.isEmpty
                              ? Icons.chat_bubble_outline
                              : Icons.search_off,
                          size: 60,
                          color: kTextDim),
                      const SizedBox(height: 16),
                      Text(
                          query.isEmpty
                              ? "Aucune conversation"
                              : "Aucun résultat",
                          style: const TextStyle(color: kTextDim)),
                      const SizedBox(height: 8),
                      Text(
                          query.isEmpty
                              ? "Appuie sur + pour ajouter un contact"
                              : "Essaie un autre nom ou numéro",
                          style:
                              const TextStyle(color: kTextDim, fontSize: 12)),
                    ]),
              );
            }

            final children = <Widget>[];

            children.add(Padding(
              padding: const EdgeInsets.fromLTRB(15, 8, 15, 12),
              child: Container(
                padding: const EdgeInsets.all(16),
                decoration: BoxDecoration(
                  borderRadius: BorderRadius.circular(24),
                  gradient: LinearGradient(
                    colors: [
                      kSurface.withOpacity(0.98),
                      kCard.withOpacity(0.98),
                    ],
                    begin: Alignment.topLeft,
                    end: Alignment.bottomRight,
                  ),
                  border: Border.all(color: kCyan.withOpacity(0.16)),
                  boxShadow: [
                    BoxShadow(
                      color: Colors.black.withOpacity(0.28),
                      blurRadius: 28,
                      offset: const Offset(0, 14),
                    ),
                  ],
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Container(
                          width: 46,
                          height: 46,
                          decoration: BoxDecoration(
                            shape: BoxShape.circle,
                            gradient: const LinearGradient(
                              colors: [kViolet, kCyan],
                              begin: Alignment.topLeft,
                              end: Alignment.bottomRight,
                            ),
                            boxShadow: [
                              BoxShadow(
                                color: kCyan.withOpacity(0.26),
                                blurRadius: 18,
                                spreadRadius: 1,
                              ),
                            ],
                          ),
                          child: const Icon(Icons.people_alt_rounded,
                              color: Colors.white, size: 23),
                        ),
                        const SizedBox(width: 12),
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              const Text(
                                'Messagerie privée',
                                style: TextStyle(
                                  color: kText,
                                  fontSize: 17,
                                  fontWeight: FontWeight.w700,
                                ),
                              ),
                              const SizedBox(height: 2),
                              Text(
                                'Retrouve tes conversations et ajoute un numéro en un geste.',
                                style: TextStyle(
                                  color: kTextDim.withOpacity(0.95),
                                  fontSize: 12,
                                ),
                              ),
                            ],
                          ),
                        ),
                      ],
                    ),
                    const SizedBox(height: 14),
                    Wrap(
                      spacing: 8,
                      runSpacing: 8,
                      children: [
                        _HeaderChip(
                          icon: Icons.person_outline,
                          label: activeAccountName,
                        ),
                        _HeaderChip(
                          icon: Icons.forum_outlined,
                          label:
                              '${threadCards.length} conversation${threadCards.length > 1 ? 's' : ''}',
                        ),
                        _HeaderChip(
                          icon: Icons.contacts_outlined,
                          label:
                              '${filteredContacts.length} contact${filteredContacts.length > 1 ? 's' : ''}',
                        ),
                      ],
                    ),
                    const SizedBox(height: 14),
                    TextField(
                      onChanged: (value) =>
                          setState(() => _contactsSearch = value),
                      style: const TextStyle(color: kText),
                      decoration: InputDecoration(
                        hintText: 'Rechercher un contact ou un numéro',
                        hintStyle: TextStyle(color: kTextDim.withOpacity(0.8)),
                        prefixIcon: const Icon(Icons.search, color: kCyan),
                        suffixIcon: _contactsSearch.isEmpty
                            ? null
                            : IconButton(
                                tooltip: 'Effacer',
                                icon: const Icon(Icons.close, color: kTextDim),
                                onPressed: () =>
                                    setState(() => _contactsSearch = ''),
                              ),
                        filled: true,
                        fillColor: kBg.withOpacity(0.45),
                        border: OutlineInputBorder(
                          borderRadius: BorderRadius.circular(16),
                          borderSide: BorderSide.none,
                        ),
                        contentPadding: const EdgeInsets.symmetric(
                            horizontal: 16, vertical: 14),
                      ),
                    ),
                  ],
                ),
              ),
            ));

            if (filteredThreads.isNotEmpty) {
              children.add(const Padding(
                padding: EdgeInsets.fromLTRB(18, 8, 18, 8),
                child: Text('Conversations récentes',
                    style: TextStyle(
                        color: kCyan,
                        fontSize: 12,
                        fontWeight: FontWeight.bold,
                        letterSpacing: 1.2)),
              ));

              for (final item in filteredThreads) {
                final docId = item['docId'] as String;

                final peer = item['peer'] as String;

                final displayName = item['displayName'] as String;

                final lastMessage = item['lastMessage'] as String;

                final contactData =
                    item['contactData'] as Map<String, dynamic>?;

                children.add(Padding(
                  padding: const EdgeInsets.only(bottom: 10),
                  child: Dismissible(
                    key: ValueKey('thread_$docId'),
                    direction: DismissDirection.horizontal,
                    background: Container(
                      alignment: Alignment.centerLeft,
                      padding: const EdgeInsets.only(left: 20),
                      decoration: BoxDecoration(
                        color: kCyan.withOpacity(0.15),
                        borderRadius: BorderRadius.circular(16),
                        border: Border.all(color: kCyan.withOpacity(0.4)),
                      ),
                      child: const Icon(Icons.archive_outlined,
                          color: kCyan, size: 26),
                    ),
                    secondaryBackground: Container(
                      alignment: Alignment.centerRight,
                      padding: const EdgeInsets.only(right: 20),
                      decoration: BoxDecoration(
                        color: kPink.withOpacity(0.15),
                        borderRadius: BorderRadius.circular(16),
                        border: Border.all(color: kPink.withOpacity(0.4)),
                      ),
                      child: const Icon(Icons.delete_outline,
                          color: kPink, size: 26),
                    ),
                    confirmDismiss: (direction) async {
                      if (direction == DismissDirection.startToEnd) {
                        await _archiveThread(peer);

                        return true;
                      }

                      if (direction == DismissDirection.endToStart) {
                        await _deleteThread(peer);

                        return true;
                      }

                      return false;
                    },
                    child: GestureDetector(
                      onTap: () => _openConversation(peer, data: contactData),
                      child: GlassCard(
                        borderColor: contactData == null ? kCyan : kViolet,
                        child: Row(children: [
                          Stack(children: [
                            _buildContactAvatar(
                                contactData ??
                                    {'contact': peer, 'name': displayName},
                                size: 48),
                            Positioned(
                              bottom: 0,
                              right: 0,
                              child:
                                  PresenceIndicator(userPhone: peer, size: 10),
                            ),
                          ]),
                          const SizedBox(width: 15),
                          Expanded(
                            child: Column(
                              crossAxisAlignment: CrossAxisAlignment.start,
                              children: [
                                Row(
                                  children: [
                                    Expanded(
                                      child: Text(
                                        displayName,
                                        style: const TextStyle(
                                            color: kText,
                                            fontWeight: FontWeight.w500),
                                        maxLines: 1,
                                        overflow: TextOverflow.ellipsis,
                                      ),
                                    ),
                                    if (contactData == null)
                                      Container(
                                        padding: const EdgeInsets.symmetric(
                                            horizontal: 8, vertical: 3),
                                        decoration: BoxDecoration(
                                          color: kCyan.withOpacity(0.12),
                                          borderRadius:
                                              BorderRadius.circular(999),
                                          border: Border.all(
                                              color: kCyan.withOpacity(0.3)),
                                        ),
                                        child: const Text('Inconnu',
                                            style: TextStyle(
                                                color: kCyan, fontSize: 10)),
                                      ),
                                  ],
                                ),
                                Text(peer,
                                    style: const TextStyle(
                                        color: kTextDim, fontSize: 11)),
                                const SizedBox(height: 2),
                                Text(
                                  lastMessage.isEmpty
                                      ? 'Conversation vide'
                                      : lastMessage,
                                  style: const TextStyle(
                                      color: kTextDim, fontSize: 11),
                                  maxLines: 1,
                                  overflow: TextOverflow.ellipsis,
                                ),
                              ],
                            ),
                          ),
                          const Icon(Icons.chevron_right, color: kTextDim),
                        ]),
                      ),
                    ),
                  ),
                ));
              }
            }

            if (filteredContacts.isNotEmpty) {
              children.add(const Padding(
                padding: EdgeInsets.fromLTRB(18, 14, 18, 8),
                child: Text('Contacts',
                    style: TextStyle(
                        color: kCyan,
                        fontSize: 12,
                        fontWeight: FontWeight.bold,
                        letterSpacing: 1.2)),
              ));

              for (final doc in filteredContacts) {
                final data = doc.data() as Map<String, dynamic>;

                final contact = data['contact'] as String;

                final name = data['name'] as String? ?? contact;

                final email = data['email'] as String?;

                children.add(Padding(
                  padding: const EdgeInsets.only(bottom: 10),
                  child: Dismissible(
                    key: ValueKey(doc.id),
                    direction: DismissDirection.endToStart,
                    background: Container(
                      alignment: Alignment.centerRight,
                      padding: const EdgeInsets.only(right: 20),
                      decoration: BoxDecoration(
                        color: kPink.withOpacity(0.15),
                        borderRadius: BorderRadius.circular(16),
                        border: Border.all(color: kPink.withOpacity(0.4)),
                      ),
                      child: const Icon(Icons.delete_outline,
                          color: kPink, size: 26),
                    ),
                    confirmDismiss: (_) async {
                      await _deleteContact(doc.id, contact, name);

                      return false;
                    },
                    child: GestureDetector(
                      onTap: () => _openConversation(contact, data: data),
                      child: GlassCard(
                        borderColor: kViolet,
                        child: Row(children: [
                          Stack(children: [
                            _buildContactAvatar(data, size: 48),
                            Positioned(
                              bottom: 0,
                              right: 0,
                              child: PresenceIndicator(
                                  userPhone: contact, size: 10),
                            ),
                          ]),
                          const SizedBox(width: 15),
                          Expanded(
                            child: Column(
                                crossAxisAlignment: CrossAxisAlignment.start,
                                children: [
                                  Text(name,
                                      style: const TextStyle(
                                          color: kText,
                                          fontWeight: FontWeight.w500)),
                                  Text(contact,
                                      style: const TextStyle(
                                          color: kTextDim, fontSize: 11)),
                                  if (email != null)
                                    Text(email,
                                        style: const TextStyle(
                                            color: kTextDim, fontSize: 10)),
                                  StreamBuilder<Map<String, dynamic>>(
                                    stream:
                                        PresenceService.watchPresence(contact),
                                    builder: (c, snap) {
                                      final data =
                                          snap.data ?? <String, dynamic>{};

                                      final online = data['online'] == true;

                                      final lastSeenValue = data['lastSeen'];

                                      String status = 'Hors ligne';

                                      Color statusColor = kTextDim;

                                      if (online) {
                                        status = 'En ligne';

                                        statusColor = kCyan;
                                      } else if (lastSeenValue != null) {
                                        final time = lastSeenValue is int
                                            ? DateTime
                                                .fromMillisecondsSinceEpoch(
                                                    lastSeenValue)
                                            : lastSeenValue is String
                                                ? DateTime.tryParse(
                                                    lastSeenValue)
                                                : null;

                                        if (time != null) {
                                          final diff =
                                              DateTime.now().difference(time);

                                          if (diff.inMinutes < 60) {
                                            status =
                                                'Il y a ${diff.inMinutes}min';

                                            statusColor = kViolet;
                                          } else if (diff.inHours < 24) {
                                            status = 'Il y a ${diff.inHours}h';
                                          }
                                        }
                                      }

                                      return Text(status,
                                          style: TextStyle(
                                              color: statusColor,
                                              fontSize: 11));
                                    },
                                  ),
                                ]),
                          ),
                          IconButton(
                            icon: const Icon(Icons.delete_outline,
                                color: kPink, size: 20),
                            onPressed: () =>
                                _deleteContact(doc.id, contact, name),
                            tooltip: 'Supprimer',
                          ),
                          const Icon(Icons.chevron_right, color: kTextDim),
                        ]),
                      ),
                    ),
                  ),
                ));
              }
            }

            return ListView(
              key: const PageStorageKey('privateContacts'),
              padding: const EdgeInsets.fromLTRB(15, 15, 15, 160),
              children: children,
            );
          },
        );
      },
    );
  }

  Widget _buildChat() {
    final chatId = _getChatId(widget.userPhone, _selectedContact!);

    return Column(children: [
      if (_pinnedMessage != null)
        _PinnedMessageBanner(
          text: _pinnedMessage!['text'] ?? '',
          onDismiss: () => setState(() => _pinnedMessage = null),
        ),
      Expanded(
        child: StreamBuilder<QuerySnapshot>(
          stream: FirebaseFirestore.instance
              .collection('private_messages')
              .doc(chatId)
              .collection('msgs')
              .orderBy('time', descending: true)
              .snapshots(),
          builder: (context, snapshot) {
            if (snapshot.hasError)
              return const Center(
                  child: Text('Erreur', style: TextStyle(color: kPink)));

            if (!snapshot.hasData)
              return const Center(
                  child: CircularProgressIndicator(color: kViolet));

            final docs = snapshot.data!.docs;

            if (docs.isEmpty)
              return const Center(
                  child: Text("Début de la conversation...",
                      style: TextStyle(color: kTextDim)));

            _markAsSeen(docs, chatId);

            return ListView.builder(
              reverse: true,
              padding: const EdgeInsets.all(15),
              itemCount: docs.length,
              itemBuilder: (c, i) {
                final doc = docs[i];

                final data = doc.data() as Map<String, dynamic>;

                final docId = doc.id;

                final ephemeralAt = data['ephemeralAt'] as int?;

                if (ephemeralAt != null &&
                    DateTime.now().millisecondsSinceEpoch > ephemeralAt) {
                  return const SizedBox.shrink();
                }

                final bool isMe = data['sender'] == widget.userPhone;

                return GestureDetector(
                  onLongPress: () => _showMessageActions(context, data, docId),
                      child: _MessageBubble(
                        data: data,
                        isMe: isMe,
                        ephemeralAt: ephemeralAt,
                        audioService: _audioService),
                );
              },
            );
          },
        ),
      ),
      TypingIndicator(chatId: chatId, myPhone: widget.userPhone),
      _buildInputBar(),
    ]);
  }

  Widget _buildInputBar() {
    return Column(children: [
      if (_replyToMessage != null)
        _ReplyBanner(
          text: _replyToMessage!['text'] ?? '',
          sender: _replyToMessage!['sender'] ?? '',
          isMe: _replyToMessage!['sender'] == widget.userPhone,
          onCancel: () => setState(() => _replyToMessage = null),
        ),
      if (_editingMessageId != null)
        Container(
          padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
          color: kPink.withOpacity(0.1),
          child: Row(children: [
            const Icon(Icons.edit, color: kPink, size: 14),
            const SizedBox(width: 8),
            const Text('Modification en cours',
                style: TextStyle(color: kPink, fontSize: 12)),
            const Spacer(),
            GestureDetector(
              onTap: () => setState(() {
                _editingMessageId = null;

                _msgC.clear();
              }),
              child: const Icon(Icons.close, color: kPink, size: 16),
            ),
          ]),
        ),
      if (_isRecording) _buildVoiceRecordingIndicator(),
      if (_voiceUploadStatus.isNotEmpty)
        _buildVoiceSendingIndicator()
      else if (_isSendingFile)
        LinearProgressIndicator(color: kViolet, backgroundColor: kCard),
      Container(
        padding: const EdgeInsets.all(12),
        decoration: BoxDecoration(
          color: kSurface,
          border: Border(
              top: BorderSide(color: kViolet.withOpacity(0.2), width: 1)),
        ),
        child: Row(children: [
          GestureDetector(
            onTap: _showAttachmentMenu,
            child: Container(
              padding: const EdgeInsets.all(8),
              decoration: BoxDecoration(
                shape: BoxShape.circle,
                color: kCard,
                border: Border.all(color: kViolet.withOpacity(0.3)),
              ),
              child: const Icon(Icons.attach_file, color: kViolet, size: 20),
            ),
          ),
          const SizedBox(width: 8),
          if (_ghostMode)
            const Padding(
              padding: EdgeInsets.only(right: 8),
              child: Icon(Icons.visibility_off, color: kPink, size: 16),
            ),
          Expanded(
            child: TextField(
              controller: _msgC,
              style: const TextStyle(color: kText),
              maxLines: 4,
              minLines: 1,
              decoration: InputDecoration(
                hintText: _editingMessageId != null
                    ? "Modifier le message..."
                    : "Message privé...",
                hintStyle: const TextStyle(color: kTextDim),
                contentPadding:
                    const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
              ),
            ),
          ),
          const SizedBox(width: 8),
          Column(
            mainAxisSize: MainAxisSize.min,
            children: [
              GestureDetector(
                onTap: () async {
                  if (_msgC.text.isNotEmpty) {
                    _sendMessage();

                    return;
                  }

                  if (_isRecording) {
                    final path = await _audioService.stopRecording();

                    if (path != null && _selectedContact != null) {
                      final url = await _audioService.uploadAudioToFirebase(
                        localPath: path,
                        senderPhone: widget.userPhone,
                      );

                      final chatId = _getChatId(widget.userPhone, _selectedContact!);

                      await _audioService.saveAudioMetadata(
                        conversationId: chatId,
                        senderPhone: widget.userPhone,
                        receiverPhone: _selectedContact!,
                        audioUrl: url,
                        durationSeconds: _recordDuration,
                      );
                    }

                    setState(() => _isRecording = false);
                  } else {
                    setState(() => _isRecording = true);

                    await _audioService.startRecording();
                  }
                },
                onLongPress: _msgC.text.isEmpty
                    ? () async {
                        setState(() => _isRecording = true);

                        await _audioService.startRecording();
                      }
                    : null,
                onLongPressEnd: _msgC.text.isEmpty
                    ? (_) async {
                        final path = await _audioService.stopRecording();

                        if (path != null && _selectedContact != null) {
                          final url = await _audioService.uploadAudioToFirebase(
                            localPath: path,
                            senderPhone: widget.userPhone,
                          );

                          final chatId = _getChatId(widget.userPhone, _selectedContact!);

                          await _audioService.saveAudioMetadata(
                            conversationId: chatId,
                            senderPhone: widget.userPhone,
                            receiverPhone: _selectedContact!,
                            audioUrl: url,
                            durationSeconds: _recordDuration,
                          );
                        }

                        setState(() => _isRecording = false);
                      }
                    : null,
                child: AnimatedContainer(
                  duration: const Duration(milliseconds: 200),
                  padding: const EdgeInsets.all(12),
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    gradient: LinearGradient(
                      colors: _isRecording
                          ? [kPink, kViolet]
                          : _editingMessageId != null
                              ? [kPink, kViolet]
                              : [kViolet, kPink],
                    ),
                    boxShadow: [
                      BoxShadow(
                        color:
                            (_isRecording ? kPink : kViolet).withOpacity(0.3),
                        blurRadius: 15,
                      )
                    ],
                  ),
                  child: Icon(
                    _isRecording
                        ? Icons.stop
                        : _msgC.text.isEmpty
                            ? Icons.mic
                            : _editingMessageId != null
                                ? Icons.check
                                : Icons.send,
                    color: Colors.white,
                    size: 20,
                  ),
                ),
              ),
              const SizedBox(height: 4),
              if (_msgC.text.isEmpty)
                Text(
                  _isRecording
                      ? 'Relâchez pour envoyer'
                      : 'Maintenez pour enregistrer',
                  style: const TextStyle(color: kTextDim, fontSize: 10),
                ),
            ],
          ),
        ]),
      ),
    ]);
  }

  Widget _buildVoiceRecordingIndicator() {
    return AnimatedBuilder(
      animation: _voiceMeterController,
      builder: (context, child) {
        final value = _voiceMeterController.value;

        return Container(
          margin: const EdgeInsets.only(bottom: 10),
          padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
          decoration: BoxDecoration(
            color: kCard,
            borderRadius: BorderRadius.circular(16),
            border: Border.all(color: kPink.withOpacity(0.25)),
          ),
          child: Row(
            children: [
              Container(
                width: 10,
                height: 10,
                decoration: const BoxDecoration(
                  shape: BoxShape.circle,
                  color: kPink,
                ),
              ),
              const SizedBox(width: 10),
              const Text(
                'Message vocal en cours',
                style: TextStyle(color: kText, fontSize: 12),
              ),
              const SizedBox(width: 12),
              Expanded(
                child: Row(
                  mainAxisAlignment: MainAxisAlignment.end,
                  children: List.generate(6, (index) {
                    final phase = (value + index * 0.13) % 1.0;
                    final pulse = 1 - ((phase - 0.5).abs() * 2).clamp(0.0, 1.0);
                    final height = 6.0 + (pulse * 16.0);

                    return Padding(
                      padding: const EdgeInsets.symmetric(horizontal: 2),
                      child: Container(
                        width: 4,
                        height: height,
                        decoration: BoxDecoration(
                          color: kPink.withOpacity(0.55 + (pulse * 0.35)),
                          borderRadius: BorderRadius.circular(8),
                        ),
                      ),
                    );
                  }),
                ),
              ),
            ],
          ),
        );
      },
    );
  }

  Widget _buildVoiceSendingIndicator() {
    final hasProgress = _voiceUploadProgress > 0 && _voiceUploadProgress < 1;

    return Container(
      margin: const EdgeInsets.only(bottom: 10),
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 10),
      decoration: BoxDecoration(
        color: kCard,
        borderRadius: BorderRadius.circular(16),
        border: Border.all(color: kViolet.withOpacity(0.18)),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Row(
            children: [
              const Icon(Icons.cloud_upload_outlined,
                  color: kViolet, size: 18),
              const SizedBox(width: 8),
              Expanded(
                child: Text(
                  _voiceUploadStatus.isEmpty
                      ? 'Envoi du message vocal...'
                      : _voiceUploadStatus,
                  style: const TextStyle(color: kText, fontSize: 12),
                ),
              ),
              if (hasProgress)
                Text(
                  '${(_voiceUploadProgress * 100).toStringAsFixed(0)} %',
                  style: const TextStyle(color: kTextDim, fontSize: 11),
                ),
            ],
          ),
          const SizedBox(height: 8),
          ClipRRect(
            borderRadius: BorderRadius.circular(999),
            child: LinearProgressIndicator(
              value: hasProgress ? _voiceUploadProgress : null,
              minHeight: 4,
              color: kViolet,
              backgroundColor: kViolet.withOpacity(0.12),
            ),
          ),
        ],
      ),
    );
  }

  void _showAttachmentMenu() {
    showModalBottomSheet(
      context: context,
      backgroundColor: kSurface,
      shape: const RoundedRectangleBorder(
          borderRadius: BorderRadius.vertical(top: Radius.circular(24))),
      builder: (_) => SafeArea(
        child: Column(mainAxisSize: MainAxisSize.min, children: [
          Container(
              width: 40,
              height: 4,
              margin: const EdgeInsets.only(top: 12, bottom: 20),
              decoration: BoxDecoration(
                  color: kTextDim.withOpacity(0.3),
                  borderRadius: BorderRadius.circular(2))),
          Row(mainAxisAlignment: MainAxisAlignment.spaceEvenly, children: [
            _attachItem(
                icon: Icons.image,
                label: 'Photo',
                color: kCyan,
                onTap: () {
                  Navigator.pop(context);

                  _pickAndSendImage();
                }),
            _attachItem(
                icon: Icons.videocam,
                label: 'Vidéo',
                color: kPink,
                onTap: () {
                  Navigator.pop(context);

                  _pickAndSendVideo();
                }),
            _attachItem(
                icon: Icons.insert_drive_file,
                label: 'Fichier',
                color: kGold,
                onTap: () {
                  Navigator.pop(context);

                  _pickAndSendFile();
                }),
            _attachItem(
                icon: Icons.camera_alt,
                label: 'Caméra',
                color: kViolet,
                onTap: () {
                  Navigator.pop(context);

                  _pickAndSendImageFromCamera();
                }),
          ]),
          const SizedBox(height: 24),
        ]),
      ),
    );
  }

  Widget _attachItem(
      {required IconData icon,
      required String label,
      required Color color,
      required VoidCallback onTap}) {
    return GestureDetector(
      onTap: onTap,
      child: Column(children: [
        Container(
          width: 56,
          height: 56,
          decoration: BoxDecoration(
            shape: BoxShape.circle,
            color: color.withOpacity(0.12),
            border: Border.all(color: color.withOpacity(0.4)),
          ),
          child: Icon(icon, color: color, size: 26),
        ),
        const SizedBox(height: 8),
        Text(label,
            style: TextStyle(
                color: color, fontSize: 11, fontWeight: FontWeight.w500)),
      ]),
    );
  }
}

class _HeaderChip extends StatelessWidget {
  final IconData icon;

  final String label;

  const _HeaderChip({required this.icon, required this.label});

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
      decoration: BoxDecoration(
        color: kBg.withOpacity(0.55),
        borderRadius: BorderRadius.circular(999),
        border: Border.all(color: kTextDim.withOpacity(0.12)),
      ),
      child: Row(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(icon, color: kCyan, size: 14),
          const SizedBox(width: 6),
          Text(
            label,
            style: const TextStyle(
              color: kWhite,
              fontSize: 12,
              fontWeight: FontWeight.w600,
            ),
          ),
        ],
      ),
    );
  }
}
