    final textScale = (_privateFontSize.clamp(1, 10)) / 5.0;

    return WillPopScope(
      onWillPop: _onWillPop,
      child: MediaQuery(
        data: MediaQuery.of(context).copyWith(textScaleFactor: textScale),
        child: Scaffold(
          backgroundColor: Colors.transparent,
          appBar: null,
