                            ),
                            centerTitle: true,
                            title: const Row(
                              mainAxisAlignment: MainAxisAlignment.center,
                              children: [
                                Icon(Icons.lock, color: kViolet, size: 18),
                                SizedBox(width: 8),
                                Text('MESSAGES PRIVÉS',
                                    style:
                                        TextStyle(color: kCyan, fontSize: 14)),
                              ],
                            ),
                            actions: [
                              IconButton(
                                tooltip: 'Paramètres privés',
                                icon: Icon(Icons.settings, color: kCyan),
