                              )
                            ],
                            leading: IconButton(
                              icon: const Icon(Icons.arrow_back, color: kCyan),
                              onPressed: () {
                                if (widget.onReturnToFeed != null) {
                                  widget.onReturnToFeed!();
                                } else {
